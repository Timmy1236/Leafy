{
  "name": "leafy",
  "type": "module",
  "version": "1.0.0",
  "description": "Un simple bot para discord, nada más, simple como eso.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true });\"",
    "build": "pnpm clean && tsc",
    "start": "node dist/index.js",
    "dev": "pnpm build && pnpm start",
    "sync": "pnpm build && node dist/scripts/sync_slash.js",
    "lint": "npx --node-options=--experimental-strip-types eslint --flag unstable_native_nodejs_ts_config"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timmy1236/Leafy.git"
  },
  "author": "Timmy1236 (https://timmy.nekoweb.org/)",
  "licenses": [
    {
      "type": "GPL-3.0-only",
      "url": "https://github.com/Timmy1236/Leafy/blob/main/LICENSE"
    }
  ],
  "bugs": {
    "url": "https://github.com/Timmy1236/Leafy/issues"
  },
  "homepage": "https://github.com/Timmy1236/Leafy#readme",
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}